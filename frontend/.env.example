# URL base de los webhooks de n8n (sin slash al final)
# Ejemplo: https://tu-instancia.n8n.io/webhook
VITE_N8N_BASE_URL=https://PENDIENTE.n8n.io/webhook

# Cambiar a "false" cuando el backend esté listo para usar datos reales
# Mientras esté en "true", toda la app usa los datos de mockData.js
VITE_USE_MOCK=true

# ── Supabase (solo autenticación / sesión) ──────────────────
# Estas dos son PÚBLICAS (URL del proyecto + llave publishable/anon).
# Se copian de Supabase → Settings → API Keys.
# ⚠️ NUNCA poner aquí la service key (sb_secret_...) ni el JWT_SECRET.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXX

